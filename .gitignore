# Godot
.godot/
*.translation
export_presets.local.cfg
/build/

# gdUnit4 reports
/reports/

# Test and tool output (contact sheets and gallery outputs that are committed live under docs/)
/tests/out/
/tools/out/
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
.godot-import.log

# Native extension (ADR-0021): godot-cpp is fetched by ci/setup_godot_cpp.sh, never vendored
/native/godot-cpp/
/native/bin/
/native/.sconsign*.dblite
/native/.sconf_temp/
/native/config.log
*.o
*.os
*.obj
*.exp
*.pdb
*.ilk

# Art build (ADR-0023): the 4x masters are review products of `tools/artbuild/build.py --masters`,
# never committed and never in MANIFEST.json
/assets/art/build/**/*@4x.*
/tests/art/build/**/*@4x.*
/tests/screenshot/data/**/*@4x.*
