; Engine configuration file.
; WANE: see docs/BUILD.md section 13 and docs/adr/ for every non-default value here.

config_version=5

[application]

config/name="WANE"
config/description="A hand-drawn 2D action roguelike. You carry the last ember down."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

NativeBoot="*res://game/native/native_boot.gd"

[debug]

gdscript/warnings/directory_rules={
"res://addons/gdUnit4": 0
}
gdscript/warnings/unassigned_variable=2
gdscript/warnings/unassigned_variable_op_assign=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_local_constant=2
gdscript/warnings/unused_private_class_variable=2
gdscript/warnings/unused_parameter=2
gdscript/warnings/unused_signal=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/shadowed_global_identifier=2
gdscript/warnings/unreachable_code=2
gdscript/warnings/unreachable_pattern=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/standalone_ternary=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/static_called_on_instance=2
gdscript/warnings/missing_tool=2
gdscript/warnings/redundant_static_unload=2
gdscript/warnings/redundant_await=2
gdscript/warnings/missing_await=2
gdscript/warnings/assert_always_true=2
gdscript/warnings/assert_always_false=2
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/enum_variable_without_default=2
gdscript/warnings/empty_file=2
gdscript/warnings/deprecated_keyword=2
gdscript/warnings/confusable_identifier=2
gdscript/warnings/confusable_local_declaration=2
gdscript/warnings/confusable_local_usage=2
gdscript/warnings/confusable_capture_reassignment=2
gdscript/warnings/confusable_temporary_modification=2
gdscript/warnings/property_used_as_function=2
gdscript/warnings/constant_used_as_function=2
gdscript/warnings/function_used_as_property=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/room_editor/plugin.cfg")

[gdunit4]

settings/test/test_lookup_folder="tests"
settings/test/flaky_check_enable=false
report/godot/push_error=true
report/godot/script_error=true

[importer_defaults]

texture={
"compress/mode": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false,
"process/premult_alpha": false
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.08, 1)

[shader_globals]

wane_ink={
"type": "vec4",
"value": Vector4(0.3, 1.3, 0.8, 0.32)
}
wane_ink_wave={
"type": "vec4",
"value": Vector4(10, 4, 1, 0.22)
}
wane_fill={
"type": "vec4",
"value": Vector4(0.5, 0.04, 0.05, 0.12)
}
wane_fill_more={
"type": "vec4",
"value": Vector4(14, 1.2, 0.07, 0)
}
wane_ink_more={
"type": "vec4",
"value": Vector4(0.18, 0.2, 0.6, 3)
}
wane_ink_light={
"type": "vec4",
"value": Vector4(-0.2, 0.4, 0.15, 0.55)
}
wane_ink_bg={
"type": "vec4",
"value": Vector4(0.42, 0.5, 0.35, 48)
}
wane_ink_extra={
"type": "vec4",
"value": Vector4(0.85, 1.5, 24, 0.7)
}
wane_ambient={
"type": "color",
"value": Color(0.2, 0.17, 0.26, 1)
}
wane_dark={
"type": "float",
"value": 1.0
}
wane_key={
"type": "vec4",
"value": Vector4(-0.6, -0.8, 0.5, 1)
}
wane_ember={
"type": "vec4",
"value": Vector4(0, 0, 420, 1.6)
}
wane_light_table={
"type": "sampler2D",
"value": ""
}
wane_light_count={
"type": "int",
"value": 0
}
wane_shadow={
"type": "sampler2D",
"value": ""
}
wane_view={
"type": "vec4",
"value": Vector4(0, 0, 1920, 1080)
}
wane_room_sdf={
"type": "sampler2D",
"value": ""
}
wane_room_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 1)
}
wane_boil={
"type": "float",
"value": 0.0
}
wane_time={
"type": "float",
"value": 0.0
}
wane_shape={
"type": "vec4",
"value": Vector4(0.35, 0.95, 0.698132, 8)
}
wane_gate={
"type": "vec2",
"value": Vector2(0.05, 0.15)
}

[wane]

native/mode="auto"
