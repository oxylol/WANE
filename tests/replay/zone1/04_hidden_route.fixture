expect
  at 103 event.jump=1
  at 125 event.air_jump=1
  # Post 1 (its spikes' top 256 u up): the first bounce, a free one over the floor.
  at 150 event.pogo=1 air_jumps=1 air_dashes=1 x>1320u x<1340u
  # Post 1 to post 2, 448 u higher: the air jump and the up-dash (20 u a tick).
  at 171 event.air_jump=1
  at 191 event.dash=1 vy=-20u air_dashes=0
  # Post 2: the bounce gives the spent air dash back (the reset) ...
  at 224 air_dashes=0
  at 225 event.pogo=1 air_dashes=1 x>1480u x<1500u
  # ... and post 3, 448 u higher again, needs it.
  at 266 event.dash=1 air_dashes=0
  at 299 air_dashes=0
  at 300 event.pogo=1 air_dashes=1 x>1320u x<1340u
  at 341 event.dash=1 air_dashes=0
  at 373 air_dashes=0
  at 374 event.pogo=1 air_dashes=1 x>1480u x<1500u
  at 415 event.dash=1 air_dashes=0
  # The alcove: its floor 2048 u above the room's, inside the east wall (its face at 1664 u).
  at 450 event.land=1 y=288u x>1664u
  never 0..549 event.hazard=1
  # The drop through the floor's hole takes the player through the east door in the fall.
  at 548 event.room=1 room=zone1_05_wall_kick_climb vy=25u
end
